# Copy to .env (never commit .env) or export these in your MCP client config.
# All values are optional except BUFFER_API_KEY.

# --- Buffer -----------------------------------------------------------------
BUFFER_API_KEY=
# BUFFER_API_URL=https://api.buffer.com
# BUFFER_ORGANIZATION_ID=
# BUFFER_DEFAULT_CHANNEL_IDS=<channel-id-1>,<channel-id-2>
# BUFFER_MODE=addToQueue
# BUFFER_TIMEZONE=Asia/Shanghai
# BUFFER_DRY_RUN=false
# BUFFER_ALLOW_DESTRUCTIVE=false

# --- Cloudinary -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or a single URL: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=
# CLOUDINARY_FOLDER=buffer

# --- Transport --------------------------------------------------------------
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# Required whenever MCP_HTTP_HOST is not a loopback address.
# MCP_HTTP_TOKEN=
# MCP_HTTP_ALLOW_WRITES=false

# --- Logging ----------------------------------------------------------------
# BUFFER_MCP_LOG_LEVEL=info
# BUFFER_MCP_CONFIG=./buffer-mcp.config.json
# BUFFER_MCP_AUDIT_FILE=./buffer-mcp-audit.log
